<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fraction Fiesta!</title>
    <style>
        body {
            font-family: 'Comic Sans MS', cursive, sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            background-color: #f0f8ff;
            padding: 20px;
        }

        h1 {
            color: #ff69b4; /* Pink */
            border-bottom: 3px solid #ff69b4;
            padding-bottom: 10px;
        }

        .container {
            display: flex;
            flex-direction: column;
            gap: 20px;
            width: 90%;
            max-width: 800px;
            background-color: #fff;
            border-radius: 15px;
            padding: 20px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .visual-section {
            display: flex;
            justify-content: space-around;
            margin-bottom: 30px;
        }

        .fraction {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2em;
            font-weight: bold;
            box-shadow: 0 4px #aaa;
        }

        .piece-half {
            background-color: #ff9999; /* Light Red */
            border: 3px solid #d9534f;
        }

        .piece-quarter {
            background-color: #99ff99; /* Light Green */
            border: 3px solid #5cb85c;
        }

        #feedback {
            margin-top: 20px;
            font-size: 1.4em;
            font-weight: bold;
            min-height: 30px; /* Reserve space for feedback */
        }

        button {
            padding: 10px 20px;
            font-size: 1.1em;
            cursor: pointer;
            border: none;
            border-radius: 8px;
            background-color: #4CAF50; /* Green */
            color: white;
            transition: background-color 0.3s;
        }

        button:hover {
            background-color: #45a049;
        }

        .question {
            font-size: 1.2em;
            margin-bottom: 15px;
            color: #333;
        }

    </style>
</head>
<body>

    <h1>🍕 Fraction Fiesta! 🍎</h1>
    <p>Help the child compare fractions by finding the bigger piece!</p>

    <div class="container">
        <h2>Level 2: The Comparison Challenge</h2>
        <p class="question">Which piece is BIGGER?</p>

        <!-- Visual Section -->
        <div class="visual-section">
            <div>
                <h3>Half ($\frac{1}{2}$)</h3>
                <div id="halfPiece" class="fraction piece-half">1/2</div>
            </div>
            <div>
                <h3>Quarter ($\frac{1}{4}$)</h3>
                <div id="quarterPiece" class="fraction piece-quarter">1/4</div>
            </div>
        </div>

        <!-- Action Section -->
        <div style="text-align: center;">
            <p>Click the button below to find the correct answer!</p>
            <button onclick="checkComparison()">Find the Bigger Piece</button>
        </div>

        <!-- Feedback Section -->
        <div id="feedback">Ready to play! Click the button above.</div>
    </div>

    <script>
        // --- GAME LOGIC (JavaScript) ---

        const feedbackElement = document.getElementById('feedback');
        let isCorrect = false;

        function checkComparison() {
            // The correct answer is the Half piece, as 1/2 > 1/4
            isCorrect = true;

            if (isCorrect) {
                feedbackElement.style.color = '#28a745'; // Green for success
                feedbackElement.innerHTML = "🎉 Correct! The Half piece is BIGGER! You are a Fraction Expert!";
            } else {
                // This section would only show if the logic was wrong, but in this fixed game, it won't be hit.
                feedbackElement.style.color = '#dc3545'; // Red for failure (if we were testing a wrong answer)
                feedbackElement.innerHTML = "Oops! Try again!";
            }

            // Disable button after a successful check (or loop back)
            document.querySelector('button').disabled = true; 
        }

        // Initialize the game state (optional, just for clarity)
        document.addEventListener('DOMContentLoaded', () => {
            feedbackElement.innerHTML = "Ready to play! Click the button above.";
        });
    </script>

</body>
</html>
